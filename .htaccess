# サイト全体の設定 (Apache)

# 設定ファイルは直接公開しない
<Files "config.php">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # サイトのルートの URL (例: /tools/simple-cms/) を BASE に入れる
  RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
  RewriteRule ^(.*)$ - [E=BASE:%1]

  # サイトマップは sitemap.php が content/ から自動で作る
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # お問い合わせの確認・完了画面 (フォームの JS が confirm.html, thanks.html に遷移する)
  RewriteRule ^confirm\.html$ contact/confirm.php [L]
  RewriteRule ^thanks\.html$ contact/thanks.php [L]

  # 旧バージョン (トップの ?slug=xxx, ?page=2) の URL を, 投稿タイプのディレクトリへ恒久的に転送する
</IfModule>
