# お問い合わせフォームの設定
# このファイルを .env という名前でコピーし、値を書き換えて使う。
# .env にはパスワードが含まれるため、Git には含めない（.gitignore 済み）。

# ---- サイト設定 ----
SITE_TITLE="越前海岸盛り上げ隊"
# Origin / Referer チェックに使う（末尾のスラッシュなし）
SITE_URL="https://discoverechizen.com"
# 送信元・管理者宛の通知先
ADMIN_EMAIL="info@discoverechizen.com"

# ---- SMTP 設定（契約しているサーバーの値に書き換える）----
SMTP_HOST="smtp.example.jp"
SMTP_USER="info@discoverechizen.com"
SMTP_PASS="********"
SMTP_PORT=587
# tls（STARTTLS, 通常は 587 番）、ssl（SMTPS, 通常は 465 番）、none（暗号化なし。ローカルのテスト用のみ）
SMTP_SECURE=tls

# ---- 項目設定 ----
# 必須項目の name 属性（カンマ区切り）
REQUIRED_FIELDS="お名前,Email,メッセージ本文"
# メールアドレス入力欄の name 属性
EMAIL_FIELD="Email"

# ---- 自動返信メールの署名 ----
# ダブルクォートの中は改行をそのまま書ける
MAIL_FOOTER="
後日ご返信致しますので今しばらくお待ちください。

────────────────────────────────────────────────
福井市越前海岸盛り上げ隊
https://discoverechizen.com
────────────────────────────────────────────────
"
